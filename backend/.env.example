# Скопировать в .env и поправить под себя.
DATABASE_URL=postgres://arm112:arm112@localhost:5432/arm112

# Отдельная база для прогона проверок.
#
# Без неё тесты работают там же, где стенд: в учётных записях
# накапливаются сотни курсантов от прогонов, в переписке сценариев —
# реплики вида «проверка 1789977379959», а один из тестовых импортов
# классификатора однажды стал активной версией. Схему накатывают
# миграции при первом запуске.
TEST_DATABASE_URL=postgres://arm112:arm112@localhost:5432/arm112_test
BIND_ADDR=127.0.0.1:8080

# Секрет для подписи JWT. В проде — длинная случайная строка.
JWT_SECRET=dev-secret-change-me
JWT_TTL_HOURS=8

# Провайдер моделей: mock | onnx | http
# В MVP работает mock, система полностью функциональна без моделей.
ML_PROVIDER=mock

# Уровень логов: trace | debug | info | warn | error
RUST_LOG=info,arm112=debug,tower_http=debug

# Резервные копии. Не задан — не делаются.
# BACKUP_DIR=/var/backups/arm112
# BACKUP_KEEP_DAYS=30

# Сервер моделей для подготовки и правки вызовов.
# mock — система полностью работоспособна без моделей.
# ML_PROVIDER=http
# ML_BASE_URL=http://127.0.0.1:8090
# ML_MODEL=local

# Демонстрационный стенд: общий пароль учебных учётных записей.
# Задан — экран входа показывает учётные записи списком (только те,
# к которым пароль подходит). В рабочей установке не задавать.
# DEMO_PASSWORD=arm112
