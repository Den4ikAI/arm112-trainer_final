# Настройки стенда. deploy/up.sh при первом запуске копирует этот файл
# в deploy/.env и подставляет случайные DB_PASSWORD и JWT_SECRET.
# Сам .env в репозиторий не кладётся.

# Имя проекта docker compose: под ним живут контейнеры и тома
COMPOSE_PROJECT_NAME=arm112

# Порт, на котором стенд виден снаружи
WEB_PORT=80

# База. Пароль НЕ МЕНЯТЬ после первого запуска: PostgreSQL задаёт его
# один раз при создании тома, и с новым паролем сервер в базу не войдёт
DB_USER=arm112
DB_NAME=arm112
DB_PASSWORD=

# Подпись токенов входа
JWT_SECRET=
JWT_TTL_HOURS=8

# Языковая модель. Каталог на ВМ, куда скопирован файл весов.
# Нет файла — стенд поднимается без модели (ML_PROVIDER=mock)
MODEL_DIR=/opt/arm112/model
MODEL_FILE=full-mtp-q4_K_M.gguf
# Потоков на модель. Замер 14,8 ток/с — на шести
MODEL_THREADS=6
MODEL_CTX=8192

# Сколько дней хранить ежесуточные копии базы
BACKUP_KEEP_DAYS=14

RUST_LOG=info
