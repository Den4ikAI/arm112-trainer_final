# Настройки стенда. deploy/up.sh при первом запуске копирует этот файл
# в deploy/.env и подставляет случайные DB_PASSWORD и JWT_SECRET.
# Сам .env в репозиторий не кладётся.

# Имя проекта docker compose: под ним живут контейнеры и тома
COMPOSE_PROJECT_NAME=arm112

# Порт, на котором стенд виден снаружи
WEB_PORT=80
# HTTPS: тренажёр открывается здесь; порт 80 переадресует сюда
WEB_TLS_PORT=443

# База. Пароль НЕ МЕНЯТЬ после первого запуска: PostgreSQL задаёт его
# один раз при создании тома, и с новым паролем сервер в базу не войдёт
DB_USER=arm112
DB_NAME=arm112
DB_PASSWORD=

# Подпись токенов входа
JWT_SECRET=
JWT_TTL_HOURS=8

# Языковая модель. Каталог на ВМ, куда скопирован файл весов.
# Нет файла — стенд поднимается без модели (ML_PROVIDER=mock)
MODEL_DIR=/opt/arm112/model
MODEL_FILE=full-mtp-q4_K_M.gguf
# Потоков на модель. Замер 14,8 ток/с — на шести
MODEL_THREADS=6
MODEL_CTX=8192
# Модель на другой машине контура (OpenAI-совместимый сервер). Задан —
# up.sh не поднимает свой контейнер модели и ходит сюда. Пусто — свой
# ML_BASE_URL=http://10.0.0.5:8090

# Голос: распознавание и синтез речи на процессоре. Каталог на ВМ
# с весами: gigaam-v3-onnx/ и TeraTTSv2/ (см. deploy/README.md).
# Нет каталога — голоса нет, со старшим бригады говорят текстом
VOICE_DIR=/opt/arm112/voice
# Потоков на голос. Замер — backend/docs/замеры/ГОЛОС.md
VOICE_THREADS=4
# Сервер голоса на другой машине контура. Задан — up.sh свой не поднимает
# VOICE_BASE_URL=http://10.0.0.5:8091

# Кросс-энкодер OpenJEV: сверка описания курсанта с фактами вызова.
# Каталог на ВМ с подкаталогом чекпоинта из AlexWortega/openjev.
# Нет каталога — описание сверяет языковая модель
NLI_DIR=/opt/arm112/nli
# 2B — 9 ГБ памяти, 88 % на замере; 4B — 18 ГБ, точнее (реже ложное
# «противоречит»). Замер — backend/docs/замеры/ОПИСАНИЯ.md
NLI_MODEL=qwen3.5-2b-nli-v5
NLI_THREADS=6
# Кросс-энкодер на другой машине контура. Задан — up.sh свой не поднимает
# NLI_BASE_URL=http://10.0.0.5:8093

# Сколько дней хранить ежесуточные копии базы
BACKUP_KEEP_DAYS=14

RUST_LOG=info
