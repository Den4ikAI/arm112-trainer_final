# Единственная точка входа снаружи: статика клиента и прокси на сервер.
# Сервер приложения и модель наружу не открыты — только внутренняя
# сеть compose.

# Порт 80 — только проверка живости и переход на HTTPS. Тренажёр
# работает по HTTPS не ради красоты: микрофон браузер даёт только
# защищённой странице, и по http:// голосовой ввод недоступен совсем.
server {
    listen 80;
    server_name _;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host:${WEB_TLS_PORT}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    # Сертификат кладёт up.sh: свой из deploy/tls/, а если его нет —
    # самоподписанный на адрес машины (браузер один раз предупредит)
    ssl_certificate     /etc/nginx/tls/cert.pem;
    ssl_certificate_key /etc/nginx/tls/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    index index.html;

    # Сжимаем то, что сжимается: сборка клиента ~350 КБ скриптов
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # API. Таймаут длинный не случайно: правка вызова перепиской и сводка
    # по группе идут через языковую модель на процессоре — это десятки
    # секунд, и стандартные 60 секунд nginx обрывали бы ответ
    location /api/ {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Сервер пишет адрес клиента в журнал действий. Без этих
        # заголовков там был бы адрес nginx у всех записей
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 20m;
    }

    # Канал событий. Без Upgrade соединение не станет WebSocket'ом,
    # а без длинного таймаута nginx рвал бы тихий канал через минуту
    location /ws {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Имена файлов сборки содержат хеш — их можно кэшировать надолго
    location /assets/ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Приложение на HashRouter: маршрут живёт после «#», и серверу
    # достаточно отдавать index.html. try_files — на случай прямой
    # ссылки без решётки
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Проверка живости для docker healthcheck, без обращения к серверу
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }
}
